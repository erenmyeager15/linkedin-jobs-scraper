{
  "actorSpecification": 1,
  "name": "linkedin-jobs-scraper",
  "title": "LinkedIn Jobs Scraper - $1/1k, URLs & Job Data",
  "description": "Scrape public LinkedIn Jobs by keywords, full search URLs, or job URLs. Get salaries, skills, company data, clean descriptions, dates, filters, and external apply links. No login.",
  "version": "1.0",
  "dockerfile": "Dockerfile",
  "readme": "../README.md",
  "input": "../INPUT_SCHEMA.json",
  "output": "./output_schema.json",
  "exampleRunInput": {
    "contentType": "application/json; charset=utf-8",
    "body": "{\"keywords\":[\"software engineer\"],\"locations\":[\"United States\"],\"workplaceType\":[\"remote\"],\"datePosted\":\"past-week\",\"maxResults\":1,\"maxJobsPerSearch\":1,\"proxyConfiguration\":{\"useApifyProxy\":true,\"apifyProxyGroups\":[\"RESIDENTIAL\"]}}"
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "apify-actor-start": {
          "eventTitle": "Actor Start",
          "eventDescription": "Charged when the Actor starts. Number of events depends on memory (one per GB, minimum one).",
          "eventPriceUsd": 0.00005,
          "isPrimaryEvent": false,
          "isOneTimeEvent": true
        },
        "job-scraped": {
          "eventTitle": "Job scraped",
          "eventDescription": "Charged once for each job listing successfully scraped to the dataset.",
          "eventPriceUsd": 0.001,
          "isPrimaryEvent": true,
          "isOneTimeEvent": false
        }
      }
    }
  },
  "categories": ["JOBS", "LEAD_GENERATION", "BUSINESS"],
  "minMemoryMbytes": 1024,
  "maxMemoryMbytes": 4096,
  "defaultRunOptions": {
    "memoryMbytes": 1024,
    "timeoutSecs": 43200
  },
  "storages": {
    "dataset": "./dataset_schema.json"
  }
}
