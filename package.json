{
  "name": "linkedin-jobs-scraper",
  "version": "1.0.0",
  "description": "Public LinkedIn job data and evidence-aware US hiring watchlists",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "start": "npm run build && node dist/main.js",
    "start:prod": "node dist/main.js",
    "build": "tsc",
    "dev": "tsx src/main.ts",
    "test": "npm run build && node --test dist/*.test.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "apify": "^3.2.0",
    "crawlee": "^3.10.0",
    "linkedom": "0.18.12",
    "playwright": "^1.60.0"
  },
  "overrides": {
    "basic-ftp": "6.2.3"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
